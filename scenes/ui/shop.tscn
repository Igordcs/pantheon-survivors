[gd_scene load_steps=8 format=3]

[ext_resource type="Script" path="res://scripts/ui/shop.gd" id="1"]
[ext_resource type="Texture2D" path="res://assets/sprites/menu_bg_pixel.jpg" id="2"]
[ext_resource type="Texture2D" path="res://assets/sprites/environment/gem/BlueCoin Sheet.png" id="3"]
[ext_resource type="FontFile" path="res://assets/fonts/PressStart2P-Regular.ttf" id="4"]

[sub_resource type="AtlasTexture" id="Atlas_coin"]
atlas = ExtResource("3")
region = Rect2(0, 0, 16, 16)

[sub_resource type="Shader" id="Shader_gold"]
code = "shader_type canvas_item;\n\nvoid fragment() {\n\tvec4 source = texture(TEXTURE, UV);\n\tfloat lightness = max(source.r, max(source.g, source.b));\n\tvec3 shadow = vec3(0.24, 0.10, 0.01);\n\tvec3 gold = vec3(1.0, 0.72, 0.04);\n\tvec3 highlight = vec3(1.0, 0.96, 0.42);\n\tvec3 color = mix(shadow, gold, smoothstep(0.08, 0.72, lightness));\n\tcolor = mix(color, highlight, smoothstep(0.78, 1.0, lightness));\n\tCOLOR = vec4(color, source.a);\n}"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_gold"]
shader = SubResource("Shader_gold")

[node name="Shop" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1")

[node name="Background" type="TextureRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
texture = ExtResource("2")
expand_mode = 1
stretch_mode = 6
modulate = Color(0.45, 0.4, 0.5, 1)

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 120.0
offset_top = 45.0
offset_right = -120.0
offset_bottom = -45.0
grow_horizontal = 2
grow_vertical = 2

[node name="VBox" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 14
theme_override_fonts/font = ExtResource("4")

[node name="Header" type="HBoxContainer" parent="Margin/VBox"]
layout_mode = 2

[node name="Title" type="Label" parent="Margin/VBox/Header"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_font_sizes/font_size = 32
text = "LOJA"

[node name="CoinIcon" type="TextureRect" parent="Margin/VBox/Header"]
custom_minimum_size = Vector2(32, 32)
layout_mode = 2
material = SubResource("ShaderMaterial_gold")
texture = SubResource("Atlas_coin")
expand_mode = 1
stretch_mode = 5

[node name="CurrencyLabel" type="Label" parent="Margin/VBox/Header"]
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.82, 0.2, 1)
theme_override_font_sizes/font_size = 22
text = "MOEDAS: 0"

[node name="Tabs" type="HBoxContainer" parent="Margin/VBox"]
layout_mode = 2
