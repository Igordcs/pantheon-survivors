[gd_resource type="Resource" script_class="MapData" format=3]

[ext_resource type="Script" path="res://scripts/world/map_data.gd" id="1_map"]
[ext_resource type="TileSet" path="res://resources/map/field_tileset.tres" id="2_tileset"]
[ext_resource type="Resource" path="res://resources/biomes/field/water.tres" id="3_biome0"]
[ext_resource type="Resource" path="res://resources/biomes/field/grassland.tres" id="3_biome1"]
[ext_resource type="Resource" path="res://resources/biomes/field/forest.tres" id="3_biome2"]

[resource]
script = ExtResource("1_map")
map_id = &"field"
display_name = "Campos da Ruptura"
tile_set = ExtResource("2_tileset")
biomes = Array[Resource]([ExtResource("3_biome0"), ExtResource("3_biome1"), ExtResource("3_biome2")])
safe_biome_index = 1
