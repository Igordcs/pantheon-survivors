[resource]
script = ExtResource("1_phase")
phase_id = &"phase_1"
display_name = "Campos da Ruptura"
description = "O primeiro ponto em que o Veu falhou. Uma regiao comum, contaminada pela energia que escapa da abertura, por onde as criaturas menores comecaram a atravessar."
intro_line = "O Veu se rompeu. Reuna os Ecos. Feche a Fenda."
order = 1
map_id = &"field"
anchors = Array[ExtResource("2_anchor")]([SubResource("Anchor_0"), SubResource("Anchor_1"), SubResource("Anchor_2")])
accent_color = Color(0.55, 0.82, 0.35, 1)
