[resource]
script = ExtResource("1_phase")
phase_id = &"phase_2"
display_name = "Ruínas do Conflito"
description = "O que atravessou aqui não veio saquear: veio ocupar. Orcs, ciclopes e múmias ergueram acampamento sobre as ruínas, e a Fenda virou a porta de um exército com endereço fixo."
intro_line = "Eles não vieram saquear. Vieram ficar. Feche a porta."
