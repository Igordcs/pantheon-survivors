[resource]
script = ExtResource("1_phase")
phase_id = &"phase_3"
display_name = "Fronteira do Fim"
description = "O Fimbulvetr, o inverno que anuncia o fim, atravessou a Fenda antes da hora. As feras do Ragnarök concluíram que a profecia começou e, se não podem cumpri-la em Asgard, vão cumpri-la aqui."
intro_line = "O fim chegou ao mundo errado. Não deixe que ele se acostume."
order = 3
map_id = &"snow"
anchors = Array[ExtResource("2_anchor")]([SubResource("Anchor_0"), SubResource("Anchor_1"), SubResource("Anchor_2")])
accent_color = Color(0.45, 0.72, 0.95, 1)
