[sub_resource type="Resource" id="Level_1"]
script = ExtResource("2_level")
description = "Dispara 1 pena reta na direção em que o personagem está olhando. Dano base."

[sub_resource type="Resource" id="Level_2"]
script = ExtResource("2_level")
description = "Dispara 2 penas em paralelo. Aumenta a velocidade do projétil."
speed_multiplier = 1.3
projectile_count = 2

[sub_resource type="Resource" id="Level_3"]
script = ExtResource("2_level")
description = "Dispara 3 penas em formato de um pequeno leque (ângulo de 15 graus entre elas)."
damage_multiplier = 1.1
speed_multiplier = 1.3
projectile_count = 3
special_effect = &"fan_spread_15"
special_value = 15.0

[sub_resource type="Resource" id="Level_4"]
script = ExtResource("2_level")
description = "Adiciona Perfuração. As penas agora atravessam o primeiro inimigo e atingem o de trás."
damage_multiplier = 1.15
speed_multiplier = 1.3
projectile_count = 3
special_effect = &"pierce_1"
special_value = 1.0

[sub_resource type="Resource" id="Level_5"]
script = ExtResource("2_level")
description = "Dispara 5 penas em um leque mais largo. Reduz o tempo de recarga (cooldown)."
damage_multiplier = 1.2
cooldown_multiplier = 0.75
speed_multiplier = 1.3
projectile_count = 5
special_effect = &"fan_spread_30"
special_value = 30.0

[sub_resource type="Resource" id="Level_6"]
script = ExtResource("2_level")
description = "As penas agora dão Knockback (empurram os inimigos para trás), ótimo para abrir caminho na horda."
damage_multiplier = 1.25
cooldown_multiplier = 0.75
speed_multiplier = 1.3
projectile_count = 5
special_effect = &"knockback_light"
special_value = 250.0

[sub_resource type="Resource" id="Level_7"]
script = ExtResource("2_level")
description = "Dispara 7 penas simultâneas cobrindo uma grande área frontal."
damage_multiplier = 1.3
cooldown_multiplier = 0.75
speed_multiplier = 1.4
projectile_count = 7
special_effect = &"fan_spread_50"
special_value = 50.0

[sub_resource type="Resource" id="Level_8"]
script = ExtResource("2_level")
description = "As penas atravessam infinitos inimigos até sumirem da tela."
damage_multiplier = 1.4
cooldown_multiplier = 0.7
speed_multiplier = 1.4
projectile_count = 7
special_effect = &"pierce_infinite"
special_value = 999.0

[resource]
script = ExtResource("1_weapon")
id = &"horusfeather"
display_name = "Pena de Hórus"
icon = ExtResource("3_icon")
description = "Uma pena legendária que dispara projéteis retos e penetrantes."
base_damage = 14.0
cooldown = 1.8
area = 800.0
projectile_speed = 450.0
levels = Array[ExtResource("2_level")]([SubResource("Level_1"), SubResource("Level_2"), SubResource("Level_3"), SubResource("Level_4"), SubResource("Level_5"), SubResource("Level_6"), SubResource("Level_7"), SubResource("Level_8")])
